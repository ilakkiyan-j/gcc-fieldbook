# GCC Fieldbook Environment Configuration Template
# Copy this file to .env.local for local overrides. NEVER commit real secret keys.

NODE_ENV=development

# Supabase (Hosted PostgreSQL) - Required in Phase 2
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here (server-only, optional)

# Google Gemini (AI Copilot) - Required in Phase 5
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
